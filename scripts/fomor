#!/usr/bin/env python3
"""Fomor - a local exploration assistant for Trae.

Single-file CLI, matching the plugin convention: ``scripts/fomor`` is the only
executable entry point. Prompt/reference material lives in ``references/`` at
the repository root; user data is created silently under ``~/.fomor/``.

Commands:
    init           create ~/.fomor and default settings
    session-start  verify/repair the local environment, then catch up
    hook           read a Trae UserPromptSubmit payload from stdin
    status         show counts and schedule state
    analyze        run feedback review and analysis
    catch-up       spawn analysis if the configured daily run was missed
    prompts        list prompt tasks
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import uuid
from concurrent.futures import ThreadPoolExecutor
from copy import deepcopy
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Iterable
from zoneinfo import ZoneInfo

try:  # POSIX
    import fcntl
except ImportError:  # pragma: no cover - Windows
    fcntl = None  # type: ignore[assignment]

__version__ = "0.3.0"



# ============================================================================
# utils
# ============================================================================

def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def to_iso(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat(timespec="seconds")


def parse_iso(value: str) -> datetime:
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def local_day(value: datetime, tz_name: str) -> str:
    return value.astimezone(ZoneInfo(tz_name)).strftime("%Y-%m-%d")


def new_id(prefix: str) -> str:
    stamp = utcnow().strftime("%Y%m%d%H%M%S")
    return f"{prefix}_{stamp}_{uuid.uuid4().hex[:6]}"


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def normalize_text(value: str) -> str:
    return re.sub(r"\s+", " ", (value or "").strip()).lower()


def read_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def atomic_write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp_name)


def append_jsonl(path: Path, records: list[dict[str, Any]]) -> None:
    if not records:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        for record in records:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")
        handle.flush()
        os.fsync(handle.fileno())


def read_jsonl(path: Path) -> Iterator[dict[str, Any]]:
    if not path.exists():
        return
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


@contextlib.contextmanager
def file_lock(path: Path) -> Iterator[None]:
    """Best-effort advisory lock; no-op where fcntl is unavailable."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            if fcntl is not None:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


@contextlib.contextmanager
def try_file_lock(path: Path) -> Iterator[bool]:
    """Non-blocking advisory lock; yields False when another process holds it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+", encoding="utf-8")
    acquired = True
    if fcntl is not None:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            acquired = False
    try:
        yield acquired
    finally:
        if acquired and fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


def tokenize(value: str) -> set[str]:
    """Cheap mixed Chinese/English tokenizer for skeleton matching.

    English words of length >= 2 plus Chinese character bigrams.  Good enough
    for local feedback attribution before embeddings are introduced.
    """
    text = normalize_text(value)
    tokens = {word for word in re.findall(r"[a-z0-9_\-.]{2,}", text)}
    chinese = re.findall(r"[\u4e00-\u9fff]+", text)
    for chunk in chinese:
        if len(chunk) == 1:
            tokens.add(chunk)
        else:
            tokens.update(chunk[index : index + 2] for index in range(len(chunk) - 1))
    return tokens


def similarity(left: str, right: str) -> float:
    left_tokens, right_tokens = tokenize(left), tokenize(right)
    if not left_tokens or not right_tokens:
        return 0.0
    return len(left_tokens & right_tokens) / len(left_tokens | right_tokens)


def extract_json(text: str) -> Any:
    text = (text or "").strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text, flags=re.S)
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        pass
    match = re.search(r"[\[{].*[\]}]", text, flags=re.S)
    if not match:
        raise ValueError("no JSON object found in model output")
    return json.loads(match.group(0))


# ============================================================================
# paths
# ============================================================================

@dataclass(frozen=True)
class FomorPaths:
    root: Path

    @classmethod
    def resolve(cls, home: str | os.PathLike[str] | None = None) -> "FomorPaths":
        if home:
            root = Path(home).expanduser()
        else:
            root = Path(os.environ.get("FOMOR_HOME", "~/.fomor")).expanduser()
        return cls(root=root)

    @property
    def config_dir(self) -> Path:
        return self.root / "config"

    @property
    def settings_file(self) -> Path:
        return self.config_dir / "settings.json"

    @property
    def events_dir(self) -> Path:
        return self.root / "events"

    @property
    def topics_dir(self) -> Path:
        return self.root / "topics"

    @property
    def discoveries_dir(self) -> Path:
        return self.root / "discoveries"

    @property
    def pending_dir(self) -> Path:
        return self.discoveries_dir / "pending"

    @property
    def promoted_dir(self) -> Path:
        return self.discoveries_dir / "promoted"

    @property
    def tombstones_dir(self) -> Path:
        return self.root / "tombstones"

    @property
    def reports_dir(self) -> Path:
        return self.root / "reports"

    @property
    def runtime_dir(self) -> Path:
        return self.root / "runtime"

    @property
    def state_file(self) -> Path:
        return self.runtime_dir / "state.json"

    @property
    def runs_file(self) -> Path:
        return self.runtime_dir / "runs.json"

    @property
    def lock_file(self) -> Path:
        return self.runtime_dir / "analyze.lock"

    @property
    def catchup_lock_file(self) -> Path:
        return self.runtime_dir / "catchup.lock"

    @property
    def logs_dir(self) -> Path:
        return self.root / "logs"

    @property
    def backup_dir(self) -> Path:
        return self.root / "backup"

    def ensure(self) -> "FomorPaths":
        for path in (
            self.config_dir,
            self.events_dir,
            self.topics_dir,
            self.pending_dir,
            self.promoted_dir,
            self.tombstones_dir,
            self.reports_dir,
            self.runtime_dir,
            self.logs_dir,
            self.backup_dir,
        ):
            path.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.root, 0o700)
        except OSError:
            pass
        return self

    def event_file(self, day: str) -> Path:
        return self.events_dir / f"{day}.jsonl"


# ============================================================================
# config
# ============================================================================

DEFAULT_CONFIG: dict[str, Any] = {
    "version": 1,
    "timezone": "Asia/Shanghai",
    "schedule": {
        "hour": 3,
        "minute": 0,
        # A run is considered due when it is older than the configured daily cutoff.
        # The SessionStart catch-up uses this value to avoid running twice.
        "catch_up_after_hours": 20,
    },
    "retention": {
        "event_days": 8,
        "feedback_days": 7,
        "tombstone_days": 90,
        "dedupe_days": 2,
    },
    "llm": {
        "mode": "mock",  # mock | traecli | openai
        "model": "gpt-4o-mini",
        "base_url": "https://api.openai.com/v1",
        "api_key_env": "FOMOR_LLM_API_KEY",
        "temperature": 0.3,
        "timeout": 180,
        "traecli": "traecli",
    },
    "analysis": {
        "max_events_per_run": 200,
        "max_topics_per_run": 3,
        "min_events_for_discovery": 1,
    },
    "scoring": {
        "explore_threshold": 3.5,
        "watch_threshold": 2.0,
    },
    "feedback": {
        "strong_similarity": 0.18,
        "weak_similarity": 0.06,
    },
    "search": {
        "provider": "none",
    },
}


def _merge(base: dict[str, Any], override: dict[str, Any]) -> dict[str, Any]:
    result = deepcopy(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = _merge(result[key], value)
        else:
            result[key] = value
    return result


def load_config(paths: FomorPaths) -> dict[str, Any]:
    user_config = read_json(paths.settings_file, default={}) or {}
    return _merge(DEFAULT_CONFIG, user_config)


def save_config(paths: FomorPaths, config: dict[str, Any]) -> None:
    atomic_write_json(paths.settings_file, config)


def ensure_initialized(paths: FomorPaths) -> dict[str, Any]:
    paths.ensure()
    config = load_config(paths)
    if not paths.settings_file.exists():
        save_config(paths, config)
    return config


# ============================================================================
# store
# ============================================================================

Event = dict[str, Any]
Topic = dict[str, Any]
Discovery = dict[str, Any]


def event_fingerprint(payload: dict[str, Any]) -> str:
    platform = str(payload.get("platform") or "trae")
    session = str(payload.get("session_id") or "")
    prompt = normalize_text(str(payload.get("user_message") or ""))
    return sha256_text(f"{platform}|{session}|{prompt}")


def normalize_hook_payload(payload: dict[str, Any], now: datetime | None = None) -> Event:
    moment = now or utcnow()
    prompt = str(payload.get("prompt") or payload.get("user_message") or "").strip()
    event: Event = {
        "event_id": payload.get("event_id") or f"evt_{moment.strftime('%Y%m%d%H%M%S')}_{sha256_text(prompt)[:6]}",
        "platform": payload.get("platform") or "trae",
        "session_id": str(payload.get("session_id") or ""),
        "timestamp": to_iso(moment),
        "user_message": prompt,
        "collection_status": "collected",
        "fingerprint": "",
        "related_topic_id": None,
        "analyzed_at": None,
        "metadata": {
            "cwd": payload.get("cwd"),
            "workspace_roots": payload.get("workspace_roots") or [],
            "hook_event_name": payload.get("hook_event_name") or "UserPromptSubmit",
        },
    }
    event["fingerprint"] = event_fingerprint(event)
    return event


def find_event_by_fingerprint(paths: FomorPaths, fingerprint: str, days: int) -> Event | None:
    cutoff = utcnow() - timedelta(days=days)
    for event in iter_events(paths, since=cutoff):
        if event.get("fingerprint") == fingerprint:
            return event
    return None


def append_event(paths: FomorPaths, config: dict[str, Any], event: Event) -> tuple[Event, bool]:
    """Append unless the same message was already collected recently."""
    days = int(config["retention"]["dedupe_days"])
    existing = find_event_by_fingerprint(paths, event["fingerprint"], days)
    if existing:
        return existing, True
    day = local_day(parse_iso(event["timestamp"]), config["timezone"])
    path = paths.event_file(day)
    append_jsonl(path, [event])
    return event, False


def iter_events(
    paths: FomorPaths,
    since: datetime | None = None,
    until: datetime | None = None,
) -> Iterable[Event]:
    for path in sorted(paths.events_dir.glob("*.jsonl")):
        for event in read_jsonl(path):
            try:
                moment = parse_iso(event["timestamp"])
            except (KeyError, ValueError):
                continue
            if since and moment < since:
                continue
            if until and moment >= until:
                continue
            yield event


def mark_events_analyzed(paths: FomorPaths, events: list[Event], topic_id: str, at: datetime) -> None:
    """Rewrite only the affected daily files, preserving other records."""
    by_file: dict[Path, list[Event]] = {}
    ids = {event["event_id"] for event in events}
    if not ids:
        return
    for path in paths.events_dir.glob("*.jsonl"):
        records = list(read_jsonl(path))
        changed = False
        for record in records:
            if record.get("event_id") in ids:
                record["related_topic_id"] = topic_id
                record["analyzed_at"] = to_iso(at)
                changed = True
        if changed:
            by_file[path] = records
    for path, records in by_file.items():
        _rewrite_jsonl(path, records)


def _rewrite_jsonl(path: Path, records: list[dict[str, Any]]) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        for record in records:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")
    tmp.replace(path)


def save_topic(paths: FomorPaths, topic: Topic) -> None:
    atomic_write_json(paths.topics_dir / f"{topic['topic_id']}.json", topic)


def load_topic(paths: FomorPaths, topic_id: str) -> Topic | None:
    return read_json(paths.topics_dir / f"{topic_id}.json")


def list_topics(paths: FomorPaths) -> list[Topic]:
    topics = []
    for path in sorted(paths.topics_dir.glob("*.json")):
        payload = read_json(path)
        if payload:
            topics.append(payload)
    return topics


def save_discovery(paths: FomorPaths, discovery: Discovery) -> Path:
    status = discovery.get("status", "observing")
    directory = paths.promoted_dir if status == "promoted" else paths.pending_dir
    path = directory / f"{discovery['discovery_id']}.json"
    atomic_write_json(path, discovery)
    return path


def load_discovery(paths: FomorPaths, discovery_id: str) -> Discovery | None:
    for directory in (paths.pending_dir, paths.promoted_dir):
        payload = read_json(directory / f"{discovery_id}.json")
        if payload:
            return payload
    return None


def list_discoveries(paths: FomorPaths, status: str | None = None) -> list[Discovery]:
    result: list[Discovery] = []
    directories = []
    if status in (None, "observing"):
        directories.append(paths.pending_dir)
    if status in (None, "promoted"):
        directories.append(paths.promoted_dir)
    for directory in directories:
        for path in sorted(directory.glob("*.json")):
            payload = read_json(path)
            if payload:
                result.append(payload)
    return result


def promote_discovery(paths: FomorPaths, discovery: Discovery) -> None:
    discovery["status"] = "promoted"
    discovery["promoted_at"] = to_iso(utcnow())
    save_discovery(paths, discovery)
    pending = paths.pending_dir / f"{discovery['discovery_id']}.json"
    if pending.exists():
        pending.unlink()


def expire_discovery(paths: FomorPaths, discovery: Discovery, config: dict[str, Any]) -> None:
    pending = paths.pending_dir / f"{discovery['discovery_id']}.json"
    if pending.exists():
        pending.unlink()
    tombstone = {
        "discovery_id": discovery["discovery_id"],
        "topic_id": discovery.get("topic_id"),
        "fingerprint": sha256_text(
            " ".join(
                [
                    str(discovery.get("topic_name") or ""),
                    str(discovery.get("title") or ""),
                    " ".join(solution.get("name", "") for solution in discovery.get("other_solutions", [])),
                ]
            )
        ),
        "expired_at": to_iso(utcnow()),
        "retention_days": int(config["retention"]["tombstone_days"]),
    }
    atomic_write_json(paths.tombstones_dir / f"{discovery['discovery_id']}.json", tombstone)


def load_state(paths: FomorPaths) -> dict[str, Any]:
    return read_json(paths.state_file, default={}) or {}


def save_state(paths: FomorPaths, state: dict[str, Any]) -> None:
    atomic_write_json(paths.state_file, state)


def append_run(paths: FomorPaths, record: dict[str, Any]) -> None:
    runs = read_json(paths.runs_file, default={"runs": []}) or {"runs": []}
    runs.setdefault("runs", []).append(record)
    runs["runs"] = runs["runs"][-200:]
    atomic_write_json(paths.runs_file, runs)


def cleanup_events(paths: FomorPaths, config: dict[str, Any]) -> int:
    """Delete whole day files older than retention; never split a day."""
    cutoff = utcnow() - timedelta(days=int(config["retention"]["event_days"]))
    cutoff_day = local_day(cutoff, config["timezone"])
    removed = 0
    for path in paths.events_dir.glob("*.jsonl"):
        if path.stem < cutoff_day:
            path.unlink()
            removed += 1
    return removed


def backup_data(paths: FomorPaths, keep: int = 7) -> Path:
    stamp = utcnow().strftime("%Y%m%d%H%M%S")
    target = paths.backup_dir / f"fomor-{stamp}"
    target.mkdir(parents=True, exist_ok=True)
    for name in ("config", "topics", "discoveries", "tombstones"):
        source = paths.root / name
        if source.exists():
            shutil.copytree(source, target / name, dirs_exist_ok=True)
    backups = sorted(path for path in paths.backup_dir.glob("fomor-*") if path.is_dir())
    for old in backups[:-keep]:
        shutil.rmtree(old, ignore_errors=True)
    return target


# ============================================================================
# prompts
# ============================================================================

REFERENCE_DIR = Path(__file__).resolve().parent.parent / "references"

TASK_FILES = {
    "system": "00-system.md",
    "aggregate": "01-aggregate.md",
    "understand": "02-understand.md",
    "opportunity": "03-opportunity.md",
    "explore": "04-explore.md",
    "discovery": "05-discovery.md",
    "feedback": "06-feedback.md",
}


def _render(template: str, variables: dict[str, Any]) -> str:
    for key, value in variables.items():
        if not isinstance(value, str):
            value = json.dumps(value, ensure_ascii=False, indent=2)
        template = template.replace("{{" + key + "}}", value)
    return template


def load_system() -> str:
    return (REFERENCE_DIR / TASK_FILES["system"]).read_text(encoding="utf-8")


def build_prompt(task: str, variables: dict[str, Any]) -> str:
    if task == "system" or task not in TASK_FILES:
        raise KeyError(f"unknown prompt task: {task}")
    template = (REFERENCE_DIR / TASK_FILES[task]).read_text(encoding="utf-8")
    return load_system() + "\n\n---\n\n" + _render(template, variables)


def describe_tasks() -> list[str]:
    return sorted(name for name in TASK_FILES if name != "system")


# ============================================================================
# llm
# ============================================================================

class LLMError(RuntimeError):
    pass


class BaseLLM:
    def complete(self, task: str, variables: dict[str, Any]) -> str:
        raise NotImplementedError

    def json(self, task: str, variables: dict[str, Any]) -> Any:
        return extract_json(self.complete(task, variables))


class MockLLM(BaseLLM):
    """Deterministic output that keeps the pipeline runnable without a model."""

    def complete(self, task: str, variables: dict[str, Any]) -> str:
        events = variables.get("events") or []
        topic_name = variables.get("topic_name") or _topic_name(events)
        if task == "aggregate":
            payload: Any = {"topics": _mock_topics(events)}
        elif task == "understand":
            payload = _mock_understanding(topic_name, events)
        elif task == "opportunity":
            payload = {
                "dimensions": {
                    "solution_space": 4,
                    "potential_gain": 4,
                    "cognitive_gain": 4,
                    "applicability": 4,
                    "necessity": 3,
                },
                "total": 3.8,
                "decision": "explore",
                "rationale": "Mock 评分：当前主题存在多个可替代路径，且与用户场景相关。",
            }
        elif task == "explore":
            payload = _mock_exploration(topic_name)
        elif task == "discovery":
            payload = {
                "title": f"当「{topic_name}」开始变复杂，可以先换一种拆法",
                "observed": f"最近共记录到 {len(events)} 条相关问题，可能围绕同一主题。",
                "comparison": "当前做法更偏向在现有结构内优化；另一条路径是先重新划分职责边界。",
            }
        elif task == "feedback":
            payload = {
                "signal": "none",
                "confidence": 0.0,
                "reason": "Mock 不执行归因；真实模式由模型判断。",
            }
        else:
            raise LLMError(f"unknown task: {task}")
        return json.dumps(payload, ensure_ascii=False)


class TraeCliLLM(BaseLLM):
    """Call ``traecli exec`` non-interactively and read the last message."""

    def __init__(self, binary: str = "traecli", timeout: int = 180):
        self.binary = binary
        self.timeout = timeout

    def complete(self, task: str, variables: dict[str, Any]) -> str:
        prompt = build_prompt(task, variables)
        with tempfile.NamedTemporaryFile("r", suffix=".txt", delete=False) as handle:
            output_path = Path(handle.name)
        try:
            command = [
                self.binary,
                "exec",
                "--skip-git-repo-check",
                "--output-last-message",
                str(output_path),
                prompt,
            ]
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=self.timeout,
                check=False,
            )
            if result.returncode != 0:
                raise LLMError(result.stderr.strip() or f"traecli exited {result.returncode}")
            return output_path.read_text(encoding="utf-8")
        finally:
            output_path.unlink(missing_ok=True)


class OpenAICompatLLM(BaseLLM):
    def __init__(self, base_url: str, model: str, api_key: str, temperature: float = 0.3, timeout: int = 180):
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.api_key = api_key
        self.temperature = temperature
        self.timeout = timeout

    def complete(self, task: str, variables: dict[str, Any]) -> str:
        payload = {
            "model": self.model,
            "temperature": self.temperature,
            "messages": [
                {"role": "system", "content": "You output strict JSON only."},
                {"role": "user", "content": build_prompt(task, variables)},
            ],
        }
        request = urllib.request.Request(
            f"{self.base_url}/chat/completions",
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=self.timeout) as response:
            body = json.loads(response.read().decode("utf-8"))
        return body["choices"][0]["message"]["content"]


def build_llm(config: dict[str, Any]) -> BaseLLM:
    mode = config["llm"].get("mode", "mock")
    if mode == "mock":
        return MockLLM()
    if mode == "traecli":
        return TraeCliLLM(
            binary=config["llm"].get("traecli", "traecli"),
            timeout=int(config["llm"].get("timeout", 180)),
        )
    if mode == "openai":

        key = os.environ.get(config["llm"]["api_key_env"], "")
        if not key:
            raise LLMError(f"missing API key env: {config['llm']['api_key_env']}")
        return OpenAICompatLLM(
            base_url=config["llm"]["base_url"],
            model=config["llm"]["model"],
            api_key=key,
            temperature=float(config["llm"].get("temperature", 0.3)),
            timeout=int(config["llm"].get("timeout", 180)),
        )
    raise LLMError(f"unknown llm mode: {mode}")


