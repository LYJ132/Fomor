#!/usr/bin/env python3
"""Fomor - collect the user's Trae prompts; everything mechanical is code.

The daily analysis itself is executed by the Trae agent following
skills/SKILL.md. This script owns every mechanical step so the agent only
thinks and writes Markdown:

    hook           read a Trae UserPromptSubmit payload from stdin and store it
    session-start  silently create/verify ~/.fomor (SessionStart hook)
    prepare        one step: gather the analysis window + pending + profile,
                   drop stale event files and expired pending entries
    learn          append to the profile (what the user already knows / dislikes)
    finish         commit the run: set last_analyzed_at and the new pending index
    status         print counts, schedule and the last analysis time

The hook prints nothing on stdout (its output would be injected into the
session) and always exits 0 (it must never block the user's turn).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

__version__ = "0.5.0"

DEFAULT_CONFIG = {"timezone": "Asia/Shanghai", "schedule": "03:00"}
DEFAULT_PROFILE = {"known": [], "dislikes": []}
EVENT_RETENTION_DAYS = 8  # day-files older than this are deleted by prepare
PENDING_MAX_AGE_DAYS = 3  # pending entries older than this are dropped by prepare


# ----------------------------------------------------------------------------
# small helpers
# ----------------------------------------------------------------------------


def normalize_text(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip().lower()


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def to_iso(moment: datetime) -> str:
    return moment.astimezone(timezone.utc).isoformat()


def parse_iso(value: str) -> datetime:
    return datetime.fromisoformat(value)


def local_day(moment: datetime, tz_name: str) -> str:
    return moment.astimezone(ZoneInfo(tz_name)).strftime("%Y-%m-%d")


def read_json(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def atomic_write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


# ----------------------------------------------------------------------------
# home layout: ~/.fomor (or $FOMOR_HOME)
# ----------------------------------------------------------------------------


class Home:
    def __init__(self, root: Path):
        self.root = root

    @property
    def events_dir(self) -> Path:
        return self.root / "events"

    @property
    def reports_dir(self) -> Path:
        return self.root / "reports"

    @property
    def runtime_dir(self) -> Path:
        return self.root / "runtime"

    @property
    def config_file(self) -> Path:
        return self.root / "config.json"

    @property
    def profile_file(self) -> Path:
        return self.root / "profile.json"

    @property
    def state_file(self) -> Path:
        return self.root / "runtime" / "state.json"

    def ensure(self) -> None:
        for directory in (self.root, self.events_dir, self.reports_dir, self.runtime_dir):
            directory.mkdir(parents=True, exist_ok=True)
        try:  # POSIX only
            self.root.chmod(0o700)
        except OSError:
            pass
        if not self.config_file.exists():
            atomic_write_json(self.config_file, DEFAULT_CONFIG)
        if not self.profile_file.exists():
            atomic_write_json(self.profile_file, DEFAULT_PROFILE)

    def config(self) -> dict[str, Any]:
        data = read_json(self.config_file, default={}) or {}
        merged = dict(DEFAULT_CONFIG)
        merged.update({k: v for k, v in data.items() if k in DEFAULT_CONFIG})
        return merged

    def state(self) -> dict[str, Any]:
        return read_json(self.state_file, default={}) or {}

    def profile(self) -> dict[str, Any]:
        data = read_json(self.profile_file, default=dict(DEFAULT_PROFILE)) or dict(DEFAULT_PROFILE)
        merged = dict(DEFAULT_PROFILE)
        merged.update({k: v for k, v in data.items() if k in DEFAULT_PROFILE and isinstance(v, list)})
        return merged


# ----------------------------------------------------------------------------
# collection (hook)
# ----------------------------------------------------------------------------


def event_fingerprint(session_id: str, message: str) -> str:
    return sha256_text(f"trae|{session_id}|{normalize_text(message)}")


def normalize_hook_payload(payload: dict[str, Any], now: datetime | None = None) -> dict[str, Any]:
    """Keep only fields with a concrete reader; the agent does the rest."""
    moment = now or datetime.now(timezone.utc)
    message = str(payload.get("prompt") or payload.get("user_message") or "").strip()
    session_id = str(payload.get("session_id") or "")
    return {
        "event_id": f"evt_{moment.strftime('%Y%m%d%H%M%S')}_{sha256_text(message)[:6]}",
        "session_id": session_id,
        "timestamp": to_iso(moment),
        "user_message": message,
        "fingerprint": event_fingerprint(session_id, message),
    }


def read_day_file(path: Path) -> list[dict[str, Any]]:
    records = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            records.append(json.loads(line))
        except ValueError:
            continue
    return records


def find_duplicate(home: Home, fingerprint: str) -> bool:
    for path in sorted(home.events_dir.glob("*.jsonl")):
        for record in read_day_file(path):
            if record.get("fingerprint") == fingerprint:
                return True
    return False


def append_event(home: Home, payload: dict[str, Any]) -> tuple[dict[str, Any] | None, bool]:
    """Store the prompt. Returns (event, duplicate)."""
    event = normalize_hook_payload(payload)
    if not event["user_message"]:
        return None, False
    if find_duplicate(home, event["fingerprint"]):
        return event, True
    config = home.config()
    day = local_day(parse_iso(event["timestamp"]), config["timezone"])
    path = home.events_dir / f"{day}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, ensure_ascii=False) + "\n")
    return event, False


def count_events(home: Home) -> int:
    return sum(len(read_day_file(path)) for path in home.events_dir.glob("*.jsonl"))


# ----------------------------------------------------------------------------
# prepare: the one mechanical step before the agent thinks
# ----------------------------------------------------------------------------


def prepare(home: Home, now: datetime | None = None) -> dict[str, Any]:
    moment = now or datetime.now(timezone.utc)
    config = home.config()
    state = home.state()

    # Parallel: config/state/profile already cached cheaply; read day files and
    # decide cleanup concurrently.
    day_files = sorted(home.events_dir.glob("*.jsonl"))
    with ThreadPoolExecutor(max_workers=min(8, max(1, len(day_files)))) as pool:
        loaded = list(pool.map(read_day_file, day_files))

    # Cleanup 1: drop event day-files past retention (by filename date).
    removed_files = []
    cutoff_day = (moment - timedelta(days=EVENT_RETENTION_DAYS)).strftime("%Y-%m-%d")
    for path in day_files:
        if path.stem[:10] < cutoff_day:
            path.unlink(missing_ok=True)
            removed_files.append(path.name)

    # Cleanup 2: drop pending entries past the short judgment window.
    pending = [
        item
        for item in state.get("pending", [])
        if _age_days(item.get("created_at"), moment) is not None
        and _age_days(item.get("created_at"), moment) <= PENDING_MAX_AGE_DAYS
    ]
    dropped_pending = len(state.get("pending", [])) - len(pending)

    # Window: everything collected since the last analysis (all if never run).
    last = state.get("last_analyzed_at")
    events = [
        record
        for records in loaded
        for record in records
        if not last or record.get("timestamp", "") > last
    ]
    events.sort(key=lambda item: item.get("timestamp", ""))

    profile = home.profile()
    return {
        "now": to_iso(moment),
        "last_analyzed_at": last,
        "event_count": len(events),
        "events": events,
        "pending": pending,
        "pending_dropped": dropped_pending,
        "event_files_removed": removed_files,
        "known": profile["known"],
        "dislikes": profile["dislikes"],
    }


def _age_days(iso_value: Any, moment: datetime) -> float | None:
    try:
        return (moment - parse_iso(str(iso_value))).total_seconds() / 86400
    except (TypeError, ValueError):
        return None


# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------


def cmd_session_start(args: argparse.Namespace) -> int:
    """SessionStart hook: silently verify/repair the environment."""
    try:
        home = _home(args)
        existed = home.config_file.exists() and home.events_dir.is_dir()
        home.ensure()
        if args.verbose:
            print(
                json.dumps(
                    {
                        "ok": True,
                        "home": str(home.root),
                        "existed": bool(existed),
                        "schedule": home.config()["schedule"],
                        "timezone": home.config()["timezone"],
                    },
                    ensure_ascii=False,
                )
            )
        return 0
    except Exception as error:  # never block the session
        print(f"fomor session-start error: {error}", file=sys.stderr)
        return 0


def cmd_hook(args: argparse.Namespace) -> int:
    """Fast, silent UserPromptSubmit hook. Never breaks the user's turn."""
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else None
        if isinstance(payload, dict):
            append_event(_home(args), payload)
    except Exception as error:  # collect is best-effort
        print(f"fomor hook error: {error}", file=sys.stderr)
    return 0


def cmd_prepare(args: argparse.Namespace) -> int:
    home = _home(args)
    home.ensure()
    print(json.dumps(prepare(home), ensure_ascii=False))
    return 0


def cmd_learn(args: argparse.Namespace) -> int:
    """Append one entry to the profile (what the user knows / dislikes)."""
    home = _home(args)
    home.ensure()
    if not args.known and not args.dislike:
        print("fomor learn: require --known NAME or --dislike NAME", file=sys.stderr)
        return 1
    if args.known and args.dislike:
        print("fomor learn: --known and --dislike are exclusive", file=sys.stderr)
        return 1
    profile = home.profile()
    entry = {
        "name": args.known or args.dislike,
        "note": args.note or "",
        "at": to_iso(datetime.now(timezone.utc)),
    }
    key = "known" if args.known else "dislikes"
    if not any(normalize_text(item.get("name", "")) == normalize_text(entry["name"]) for item in profile[key]):
        profile[key].append(entry)
        atomic_write_json(home.profile_file, profile)
    return 0


def cmd_finish(args: argparse.Namespace) -> int:
    """Commit the run: last_analyzed_at + the new pending index (from stdin)."""
    home = _home(args)
    home.ensure()
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        pending = payload.get("pending", []) if isinstance(payload, dict) else []
        if not isinstance(pending, list):
            raise ValueError("pending must be a list")
    except ValueError as error:
        print(f"fomor finish: {error}", file=sys.stderr)
        return 1
    atomic_write_json(
        home.state_file,
        {"last_analyzed_at": to_iso(datetime.now(timezone.utc)), "pending": pending},
    )
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    home = _home(args)
    home.ensure()
    config = home.config()
    state = home.state()
    profile = home.profile()
    print(f"home: {home.root}")
    print(f"events: {count_events(home)}")
    print(f"pending: {len(state.get('pending', []))}")
    print(f"profile: known={len(profile['known'])} dislikes={len(profile['dislikes'])}")
    print(f"last_analyzed_at: {state.get('last_analyzed_at', 'never')}")
    print(f"schedule: {config['schedule']} ({config['timezone']})")
    print(f"report: {home.reports_dir / 'latest.md'}")
    return 0


def _home(args: argparse.Namespace) -> Home:
    override = os.environ.get("FOMOR_HOME")
    if override:
        return Home(Path(override).expanduser())
    root = Path(args.home).expanduser() if args.home else Path("~/.fomor").expanduser()
    return Home(root)


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--home", help="data directory, default ~/.fomor (or $FOMOR_HOME)")

    parser = argparse.ArgumentParser(prog="fomor", description="Fomor prompt collector")
    parser.add_argument("--version", action="version", version=f"fomor {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    session = sub.add_parser("session-start", parents=[common], help="silently create/verify ~/.fomor")
    session.add_argument("--verbose", action="store_true", help="print the environment report")
    session.set_defaults(func=cmd_session_start)

    hook = sub.add_parser("hook", parents=[common], help="read a Trae UserPromptSubmit payload from stdin")
    hook.set_defaults(func=cmd_hook)

    prepare_cmd = sub.add_parser(
        "prepare", parents=[common], help="gather the analysis window, pending and profile; run cleanups"
    )
    prepare_cmd.set_defaults(func=cmd_prepare)

    learn = sub.add_parser("learn", parents=[common], help="append to the user profile")
    learn.add_argument("--known", metavar="NAME", help="record something the user already knows")
    learn.add_argument("--dislike", metavar="NAME", help="record something the user is not interested in")
    learn.add_argument("--note", default="", help="optional context for the entry")
    learn.set_defaults(func=cmd_learn)

    finish = sub.add_parser(
        "finish", parents=[common], help="commit the run (stdin: {\"pending\": [...]})"
    )
    finish.set_defaults(func=cmd_finish)

    status = sub.add_parser("status", parents=[common], help="print counts, schedule and last analysis time")
    status.set_defaults(func=cmd_status)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
