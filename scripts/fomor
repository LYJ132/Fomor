#!/usr/bin/env python3
"""Fomor - collect the user's Trae prompts; everything mechanical is code.

The daily exploration is executed by the Trae agent following skills/SKILL.md.
This script owns every mechanical step so the agent only thinks and writes:

    hook           read a Trae UserPromptSubmit payload from stdin and store it
    session-start  silently create/verify ~/.fomor (SessionStart hook)
    prepare        gather the events to analyze + dislikes + a read snapshot
    dislike        record one explicitly refused item (skill-invoked only)
    finish         after a successful analysis: delete the snapshot events
    status         print counts, schedule and the last successful analysis

Event lifecycle (no processed markers, no per-event state):
- hook appends to the local day file and never modifies anything else;
- prepare only READS events and records how many lines it read per file;
- finish deletes a day file only if it still has exactly the snapshotted line
  count; if the hook appended new lines during analysis, finish truncates the
  file to the snapshotted boundary so the new messages survive for next run;
- if the analysis never completes, finish is never called and events remain.

The hook prints nothing on stdout (its output would be injected into the
session) and always exits 0 (it must never block the user's turn).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import time
import uuid
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

__version__ = "0.6.0"

DEFAULT_CONFIG = {"timezone": "Asia/Shanghai", "schedule": "03:00"}
DEFAULT_PROFILE = {"version": 1, "dislikes": []}
SNAPSHOT_VERSION = 1
SNAPSHOT_MAX_AGE_HOURS = 24  # a stale snapshot is refused at finish time


# ----------------------------------------------------------------------------
# small helpers
# ----------------------------------------------------------------------------


def normalize_text(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip().lower()


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def to_iso(moment: datetime) -> str:
    return moment.astimezone(timezone.utc).isoformat()


def parse_iso(value: str) -> datetime:
    return datetime.fromisoformat(value)


def local_day(moment: datetime, tz_name: str) -> str:
    return moment.astimezone(ZoneInfo(tz_name)).strftime("%Y-%m-%d")


def read_json(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def replace_tmp(tmp: Path, path: Path) -> None:
    """os.replace with a short retry.

    On Windows the target may be transiently open by another concurrent
    process (hook first-run writing profile.json, a reader mid-scan), which
    raises PermissionError even though nothing is permanently locked. A few
    short retries absorb that without changing POSIX behavior.
    """
    for attempt in range(6):
        try:
            tmp.replace(path)
            return
        except PermissionError:
            if attempt == 5:
                raise
            time.sleep(0.05 * (attempt + 1))


def atomic_write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    # Unique per call: concurrent hooks/threads must never share a temp file.
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    replace_tmp(tmp, path)


# ----------------------------------------------------------------------------
# home layout: ~/.fomor (or $FOMOR_HOME)
# ----------------------------------------------------------------------------


class Home:
    def __init__(self, root: Path):
        self.root = root

    @property
    def events_dir(self) -> Path:
        return self.root / "events"

    @property
    def reports_dir(self) -> Path:
        return self.root / "reports"

    @property
    def runtime_dir(self) -> Path:
        return self.root / "runtime"

    @property
    def config_file(self) -> Path:
        return self.root / "config.json"

    @property
    def profile_file(self) -> Path:
        return self.root / "profile.json"

    @property
    def state_file(self) -> Path:
        return self.root / "runtime" / "state.json"

    def ensure(self) -> None:
        """Lightweight, idempotent init. Called by both hooks and all commands."""
        for directory in (self.root, self.events_dir, self.reports_dir, self.runtime_dir):
            directory.mkdir(parents=True, exist_ok=True)
        try:  # POSIX only
            self.root.chmod(0o700)
        except OSError:
            pass
        if not self.config_file.exists():
            atomic_write_json(self.config_file, DEFAULT_CONFIG)
        if not self.profile_file.exists():
            atomic_write_json(self.profile_file, DEFAULT_PROFILE)

    def config(self) -> dict[str, Any]:
        data = read_json(self.config_file, default={}) or {}
        merged = dict(DEFAULT_CONFIG)
        merged.update({k: v for k, v in data.items() if k in DEFAULT_CONFIG})
        return merged

    def state(self) -> dict[str, Any]:
        return read_json(self.state_file, default={}) or {}

    def profile(self) -> dict[str, Any]:
        """Load and self-heal the profile (v0.5 stored {"known", "dislikes"})."""
        data = read_json(self.profile_file, default=None)
        if not isinstance(data, dict):
            data = dict(DEFAULT_PROFILE)
        migrated = {"version": 1, "dislikes": data.get("dislikes", [])}
        migrated["dislikes"] = [
            item for item in migrated["dislikes"] if isinstance(item, dict) and item.get("name")
        ]
        if "known" in data or data.get("version") != 1:  # old format: drop known
            atomic_write_json(self.profile_file, migrated)
        return migrated


# ----------------------------------------------------------------------------
# collection (hook)
# ----------------------------------------------------------------------------


def event_fingerprint(session_id: str, message: str) -> str:
    return sha256_text(f"trae|{session_id}|{normalize_text(message)}")


def normalize_hook_payload(payload: dict[str, Any], now: datetime | None = None) -> dict[str, Any]:
    """User message + minimal metadata only; no processing markers."""
    moment = now or datetime.now(timezone.utc)
    message = str(payload.get("prompt") or payload.get("user_message") or "").strip()
    session_id = str(payload.get("session_id") or "")
    return {
        "event_id": f"evt_{moment.strftime('%Y%m%d%H%M%S')}_{sha256_text(message)[:6]}",
        "session_id": session_id,
        "timestamp": to_iso(moment),
        "user_message": message,
        "fingerprint": event_fingerprint(session_id, message),
    }


def read_day_file(path: Path) -> list[dict[str, Any]]:
    records = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            records.append(json.loads(line))
        except ValueError:
            continue
    return records


def count_lines(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def find_duplicate(home: Home, fingerprint: str) -> bool:
    for path in sorted(home.events_dir.glob("*.jsonl")):
        for record in read_day_file(path):
            if record.get("fingerprint") == fingerprint:
                return True
    return False


def append_event(home: Home, payload: dict[str, Any], now: datetime | None = None) -> tuple[dict[str, Any] | None, bool]:
    """Store the prompt. Returns (event, duplicate). Single append, never rewrites."""
    event = normalize_hook_payload(payload, now)
    if not event["user_message"]:
        return None, False
    home.ensure()  # first run may arrive via hook before session-start
    if find_duplicate(home, event["fingerprint"]):
        return event, True
    config = home.config()
    day = local_day(parse_iso(event["timestamp"]), config["timezone"])
    path = home.events_dir / f"{day}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    # O_APPEND single write keeps concurrent hook processes line-atomic on POSIX.
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, ensure_ascii=False) + "\n")
    return event, False


def count_events(home: Home) -> int:
    return sum(len(read_day_file(path)) for path in home.events_dir.glob("*.jsonl"))


# ----------------------------------------------------------------------------
# prepare / finish: the snapshot handover (no processed markers)
# ----------------------------------------------------------------------------


def prepare(home: Home, now: datetime | None = None) -> dict[str, Any]:
    """Read everything not yet cleaned, and record the read boundary.

    Reads only - never deletes, never marks. The snapshot is per-file line
    counts; finish uses it to remove exactly what was read.
    """
    moment = now or datetime.now(timezone.utc)
    home.ensure()
    day_files = sorted(home.events_dir.glob("*.jsonl"))
    with ThreadPoolExecutor(max_workers=min(8, max(1, len(day_files)))) as pool:
        loaded = list(pool.map(read_day_file, day_files))

    events = [record for records in loaded for record in records]
    events.sort(key=lambda item: item.get("timestamp", ""))
    return {
        "now": to_iso(moment),
        "event_count": len(events),
        "events": events,
        "dislikes": home.profile()["dislikes"],
        "snapshot": {
            "version": SNAPSHOT_VERSION,
            "cutoff": to_iso(moment),
            "files": {path.name: count_lines(path) for path in day_files},
        },
    }


def finish(home: Home, snapshot: dict[str, Any], now: datetime | None = None) -> dict[str, Any]:
    """Delete only what the snapshot covered. Returns a cleanup report.

    Raises ValueError on invalid/mismatched snapshots instead of faking success.
    """
    moment = now or datetime.now(timezone.utc)
    if not isinstance(snapshot, dict) or snapshot.get("version") != SNAPSHOT_VERSION:
        raise ValueError("snapshot invalid: missing or unsupported version")
    files = snapshot.get("files")
    if not isinstance(files, dict):
        raise ValueError("snapshot invalid: 'files' must be an object")
    cutoff = parse_iso(str(snapshot.get("cutoff", "")))
    if (moment - cutoff).total_seconds() > SNAPSHOT_MAX_AGE_HOURS * 3600:
        raise ValueError("snapshot too old: re-run prepare before finishing")

    deleted, truncated = [], []
    for name, lines in files.items():
        if not isinstance(lines, int) or lines < 0:
            raise ValueError(f"snapshot invalid: bad line count for {name}")
        path = home.events_dir / name
        if not path.exists():
            raise ValueError(f"snapshot mismatch: {name} no longer exists")
        current = count_lines(path)
        if current < lines:
            raise ValueError(f"snapshot mismatch: {name} has fewer lines than snapshot")
        if current == lines:
            path.unlink()  # fully analyzed: remove the whole day file
            deleted.append(name)
        else:
            # New messages arrived during analysis: the snapshot covers the
            # file head; keep the tail so they survive for the next run.
            all_lines = path.read_text(encoding="utf-8").splitlines()
            tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
            tmp.write_text("\n".join(all_lines[lines:]) + "\n", encoding="utf-8")
            replace_tmp(tmp, path)
            truncated.append(name)

    atomic_write_json(
        home.state_file,
        {"last_successful_analysis_at": to_iso(moment)},
    )
    return {"deleted": deleted, "truncated": truncated}


# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------


def cmd_session_start(args: argparse.Namespace) -> int:
    """SessionStart hook: silently verify/repair the environment."""
    try:
        home = _home(args)
        existed = home.config_file.exists() and home.events_dir.is_dir()
        home.ensure()
        if args.verbose:
            print(
                json.dumps(
                    {
                        "ok": True,
                        "home": str(home.root),
                        "existed": bool(existed),
                        "schedule": home.config()["schedule"],
                        "timezone": home.config()["timezone"],
                    },
                    ensure_ascii=False,
                )
            )
        return 0
    except Exception as error:  # never block the session
        print(f"fomor session-start error: {error}", file=sys.stderr)
        return 0


def cmd_hook(args: argparse.Namespace) -> int:
    """Fast, silent UserPromptSubmit hook. Never breaks the user's turn."""
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else None
        if isinstance(payload, dict):
            append_event(_home(args), payload)
    except Exception as error:  # collect is best-effort
        print(f"fomor hook error: {error}", file=sys.stderr)
    return 0


def cmd_prepare(args: argparse.Namespace) -> int:
    home = _home(args)
    print(json.dumps(prepare(home), ensure_ascii=False))
    return 0


def cmd_dislike(args: argparse.Namespace) -> int:
    """Record one explicitly refused item. Skill-invoked path only.

    The daily automation NEVER calls this (enforced by the Skill SOP, not by
    an ACL system): refusal must come from the user's own words.
    """
    home = _home(args)
    home.ensure()
    if not args.name:
        print("fomor dislike: require --name NAME", file=sys.stderr)
        return 1
    profile = home.profile()
    entry = {"name": args.name, "category": args.category or "content_preference"}
    if not any(
        normalize_text(item.get("name", "")) == normalize_text(entry["name"])
        for item in profile["dislikes"]
    ):
        profile["dislikes"].append(entry)
        atomic_write_json(home.profile_file, profile)
    return 0


def cmd_finish(args: argparse.Namespace) -> int:
    """Commit a successful analysis: delete the snapshot-covered events."""
    home = _home(args)
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        snapshot = payload.get("snapshot") if isinstance(payload, dict) else None
        report = finish(home, snapshot)
    except (ValueError, OSError) as error:
        print(f"fomor finish: {error}", file=sys.stderr)  # events stay intact
        return 1
    print(json.dumps(report, ensure_ascii=False))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    home = _home(args)
    home.ensure()
    config = home.config()
    state = home.state()
    profile = home.profile()
    last = state.get("last_successful_analysis_at") or state.get("last_analyzed_at")
    print(f"home: {home.root}")
    print(f"events: {count_events(home)}")
    print(f"dislikes: {len(profile['dislikes'])}")
    print(f"last_successful_analysis_at: {last or 'never'}")
    print(f"schedule: {config['schedule']} ({config['timezone']})")
    return 0


def _home(args: argparse.Namespace) -> Home:
    if getattr(args, "home", None):  # explicit CLI flag wins over the env var
        return Home(Path(args.home).expanduser())
    override = os.environ.get("FOMOR_HOME")
    if override:
        return Home(Path(override).expanduser())
    return Home(Path("~/.fomor").expanduser())


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--home", help="data directory, default ~/.fomor (or $FOMOR_HOME)")

    parser = argparse.ArgumentParser(prog="fomor", description="Fomor prompt collector")
    parser.add_argument("--version", action="version", version=f"fomor {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    session = sub.add_parser("session-start", parents=[common], help="silently create/verify ~/.fomor")
    session.add_argument("--verbose", action="store_true", help="print the environment report")
    session.set_defaults(func=cmd_session_start)

    hook = sub.add_parser("hook", parents=[common], help="read a Trae UserPromptSubmit payload from stdin")
    hook.set_defaults(func=cmd_hook)

    prepare_cmd = sub.add_parser(
        "prepare", parents=[common], help="gather events + dislikes + a read snapshot (no deletion)"
    )
    prepare_cmd.set_defaults(func=cmd_prepare)

    dislike = sub.add_parser(
        "dislike", parents=[common], help="record one explicitly refused item (skill-invoked only)"
    )
    dislike.add_argument("--name", metavar="NAME", help="what the user does not want to see again")
    dislike.add_argument("--category", default="content_preference", help="optional category tag")
    dislike.set_defaults(func=cmd_dislike)

    finish = sub.add_parser(
        "finish", parents=[common], help="after a successful analysis (stdin: {\"snapshot\": {...}})"
    )
    finish.set_defaults(func=cmd_finish)

    status = sub.add_parser("status", parents=[common], help="print counts, schedule, last success")
    status.set_defaults(func=cmd_status)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
