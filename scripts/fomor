# ============================================================================
# feedback
# ============================================================================

NEGATIVE_MARKERS = ("已经了解", "我知道了", "不感兴趣", "不相关", "不需要", "用不上")
STRONG_MARKERS = ("继续深入", "详细说说", "想试试", "怎么落地", "具体怎么做", "还能怎么做")


def _discovery_text(discovery: Discovery) -> str:
    parts = [str(discovery.get("topic_name") or ""), str(discovery.get("title") or "")]
    for solution in [discovery.get("primary_solution"), *discovery.get("other_solutions", [])]:
        if solution:
            parts.append(str(solution.get("name") or ""))
            parts.append(str(solution.get("core_idea") or ""))
    return " ".join(parts)


def _ensure_topic(paths: FomorPaths, discovery: Discovery) -> dict[str, Any]:
    topic = load_topic(paths, discovery["topic_id"])
    if topic:
        return topic
    now = to_iso(utcnow())
    topic = {
        "topic_id": discovery["topic_id"],
        "name": discovery.get("topic_name") or "未命名主题",
        "background": "由反馈回看补建的话题记录",
        "project": None,
        "user_goal": (discovery.get("problem_understanding") or {}).get("goal"),
        "progress": [],
        "introduced_solutions": [],
        "known": [],
        "interests": [],
        "dislikes": [],
        "practices": [],
        "corrections": [],
        "evidence": [],
        "discovery_ids": [],
        "status": "active",
        "created_at": now,
        "last_activity_at": now,
        "feedback": [],
    }
    return topic


def classify(discovery: Discovery, events: list[dict[str, Any]], config: dict[str, Any]) -> dict[str, Any]:
    """Heuristic attribution used by the offline skeleton."""
    discovery_text = _discovery_text(discovery)
    topic_name = str(discovery.get("topic_name") or "")
    best = {"signal": "none", "confidence": 0.0, "event_id": None, "score": 0.0, "reason": ""}
    for event in events:
        message = str(event.get("user_message") or "")
        if not message:
            continue
        if any(marker in message for marker in NEGATIVE_MARKERS) and topic_name and topic_name in message:
            return {
                "signal": "negative",
                "confidence": 0.7,
                "event_id": event["event_id"],
                "score": 1.0,
                "reason": "用户明确表示已了解或不感兴趣",
            }
        if any(marker in message for marker in STRONG_MARKERS) and similarity(discovery_text, message) >= float(
            config["feedback"]["weak_similarity"]
        ):
            return {
                "signal": "strong",
                "confidence": 0.8,
                "event_id": event["event_id"],
                "score": 1.0,
                "reason": "用户明确要求继续深入或尝试",
            }
        score = similarity(discovery_text, message)
        if topic_name and len(topic_name) >= 4 and topic_name in message:
            score = max(score, 0.3)
        if score > best["score"]:
            best = {
                "signal": "none",
                "confidence": 0.0,
                "event_id": event["event_id"],
                "score": score,
                "reason": "",
            }
    strong = float(config["feedback"]["strong_similarity"])
    weak = float(config["feedback"]["weak_similarity"])
    if best["score"] >= strong:
        best.update(signal="strong", confidence=min(0.9, 0.5 + best["score"]), reason="再次提到同一方案或主题")
    elif best["score"] >= weak:
        best.update(signal="weak", confidence=0.4, reason="询问同一主题下的相邻问题")
    return best


def evaluate_feedback(
    paths: FomorPaths,
    config: dict[str, Any],
    events: list[dict[str, Any]],
    run_id: str,
    now: datetime | None = None,
) -> dict[str, Any]:
    """Promote discoveries with interest, expire stale ones. Feedback first."""
    moment = now or utcnow()
    promoted, dismissed, expired, evaluated = [], [], [], []
    for discovery in list_discoveries(paths, status="observing"):
        delivered = parse_iso(discovery["created_at"])
        if delivered >= moment:
            continue
        window_events = [
            event
            for event in events
            if delivered <= parse_iso(event["timestamp"]) < moment
            and event.get("event_id") not in discovery.get("feedback_event_ids", [])
        ]
        result = classify(discovery, window_events, config)
        discovery["last_evaluated_run_id"] = run_id
        discovery["last_evaluated_at"] = to_iso(moment)
        evaluated.append(discovery["discovery_id"])

        if result["signal"] in ("strong", "weak"):
            topic = _ensure_topic(paths, discovery)
            topic.setdefault("interests", []).append(
                {
                    "discovery_id": discovery["discovery_id"],
                    "signal": result["signal"],
                    "confidence": result["confidence"],
                    "evidence_event_ids": [result["event_id"]] if result["event_id"] else [],
                    "at": to_iso(moment),
                }
            )
            topic.setdefault("evidence", []).extend(
                event_id for event_id in [result["event_id"]] if event_id and event_id not in topic["evidence"]
            )
            if discovery["topic_id"] not in topic.get("discovery_ids", []):
                topic.setdefault("discovery_ids", []).append(discovery["discovery_id"])
            topic["last_activity_at"] = to_iso(moment)
            save_topic(paths, topic)
            discovery["feedback"] = result
            promote_discovery(paths, discovery)
            promoted.append(discovery["discovery_id"])
            continue

        if result["signal"] == "negative":
            topic = _ensure_topic(paths, discovery)
            topic.setdefault("dislikes", []).append(
                {"discovery_id": discovery["discovery_id"], "reason": result["reason"], "at": to_iso(moment)}
            )
            topic["last_activity_at"] = to_iso(moment)
            save_topic(paths, topic)
            discovery["feedback"] = result
            discovery["status"] = "dismissed"
            save_discovery(paths, discovery)
            pending = paths.pending_dir / f"{discovery['discovery_id']}.json"
            if pending.exists():
                pending.unlink()
            dismissed.append(discovery["discovery_id"])
            continue

        if moment >= parse_iso(discovery["expires_at"]):
            expire_discovery(paths, discovery, config)
            expired.append(discovery["discovery_id"])
        else:
            save_discovery(paths, discovery)

    return {
        "evaluated": evaluated,
        "promoted": promoted,
        "dismissed": dismissed,
        "expired": expired,
    }


# ============================================================================
# scheduler
# ============================================================================

def latest_cutoff(now: datetime, config: dict[str, Any]) -> datetime:
    tz = ZoneInfo(config["timezone"])
    local = now.astimezone(tz)
    cutoff = local.replace(
        hour=int(config["schedule"]["hour"]),
        minute=int(config["schedule"]["minute"]),
        second=0,
        microsecond=0,
    )
    if local < cutoff:
        cutoff -= timedelta(days=1)
    return cutoff.astimezone(ZoneInfo("UTC"))


def next_cutoff(now: datetime, config: dict[str, Any]) -> datetime:
    return latest_cutoff(now, config) + timedelta(days=1)


def schedule_label(config: dict[str, Any]) -> str:
    """Human-readable daily analysis time from the user's settings."""
    return f"{int(config['schedule']['hour']):02d}:{int(config['schedule']['minute']):02d}"


def is_due(paths: FomorPaths, config: dict[str, Any], now: datetime | None = None) -> bool:
    moment = now or utcnow()
    state = load_state(paths)
    last = state.get("last_success_at")
    if not last:
        return True
    return parse_iso(last) < latest_cutoff(moment, config)


def catch_up(
    paths: FomorPaths,
    config: dict[str, Any],
    detach: bool = True,
    now: datetime | None = None,
) -> dict[str, Any]:
    """Run catch-up analysis if the latest configured cutoff was missed."""
    moment = now or utcnow()
    if not is_due(paths, config, moment):
        return {"status": "not_due", "checked_at": to_iso(moment)}

    script = Path(__file__).resolve()
    repo_root = script.parent.parent
    command = [
        sys.executable,
        str(script),
        "analyze",
        "--scheduled",
        "--home",
        str(paths.root),
    ]
    if not detach:
        return {"status": "running_inline", "command": command}

    paths.ensure()
    with try_file_lock(paths.catchup_lock_file) as acquired:
        if not acquired:
            return {"status": "busy", "checked_at": to_iso(moment)}
        env = dict(os.environ)
        log_path = paths.logs_dir / "catchup.log"
        handle = log_path.open("a", encoding="utf-8")
        handle.write(f"\n[{to_iso(moment)}] catch-up start\n")
        handle.flush()
        process = subprocess.Popen(
            command,
            stdout=handle,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            cwd=str(repo_root),
            env=env,
            start_new_session=True,
            close_fds=True,
        )
    return {"status": "spawned", "pid": process.pid, "log": str(log_path), "checked_at": to_iso(moment)}


def catch_up_inline(paths: FomorPaths, config: dict[str, Any], now: datetime | None = None) -> dict[str, Any]:
    """Helper for tests / foreground CLI: return due status only."""
    moment = now or utcnow()
    return {
        "due": is_due(paths, config, moment),
        "latest_cutoff": to_iso(latest_cutoff(moment, config)),
        "next_cutoff": to_iso(next_cutoff(moment, config)),
    }


def _safe_probe(probe) -> bool:
    try:
        return bool(probe())
    except Exception:
        return False


def _ensure_dependencies() -> list[str]:
    """Placeholder for future external dependencies.

    The current implementation is standard-library only, so there is nothing
    to download.  If a future version needs a binary, check it here and fetch
    it silently; return the list of what was fetched.
    """
    return []


def verify_environment(paths: FomorPaths, config: dict[str, Any]) -> dict[str, Any]:
    """Check the local runtime in parallel and repair what is missing.

    This is the first step of a SessionStart hook: folders and settings are
    created silently on the user's machine; nothing is printed on success.
    """
    probes = {
        "python": lambda: sys.version_info >= (3, 10),
        "home": lambda: paths.root.exists() and os.access(paths.root, os.W_OK),
        "settings": lambda: paths.settings_file.exists(),
        "workspace": lambda: all(
            path.exists()
            for path in (
                paths.events_dir,
                paths.topics_dir,
                paths.pending_dir,
                paths.promoted_dir,
                paths.reports_dir,
                paths.runtime_dir,
            )
        ),
    }
    with ThreadPoolExecutor(max_workers=len(probes)) as pool:
        results = dict(pool.map(lambda item: (item[0], _safe_probe(item[1])), probes.items()))
    missing = [name for name, ok in results.items() if not ok]

    if "python" in missing:
        print("fomor: Python 3.10+ is required", file=sys.stderr)

    repaired = []
    if any(name in missing for name in ("home", "settings", "workspace")):
        paths.ensure()
        ensure_initialized(paths)
        repaired = [name for name in missing if name != "python"]

    return {
        "ok": "python" not in missing,
        "checked": sorted(results),
        "missing": missing,
        "repaired": repaired,
        "dependencies": _ensure_dependencies(),
    }


# ============================================================================
# pipeline
# ============================================================================

def _window_start(paths: FomorPaths, state: dict[str, Any], now: datetime) -> datetime:
    last = state.get("last_success_at")
    if last:
        return parse_iso(last)
    pending = list_discoveries(paths, status="observing")
    if pending:
        return min(parse_iso(item["created_at"]) for item in pending)
    return now - timedelta(hours=24)


def _find_topic(paths: FomorPaths, name: str) -> dict[str, Any] | None:
    wanted = normalize_text(name)
    for topic in list_topics(paths):
        if normalize_text(topic.get("name", "")) == wanted:
            return topic
    return None


def _upsert_topic(
    paths: FomorPaths,
    cluster: dict[str, Any],
    understanding: dict[str, Any],
    at: str,
) -> dict[str, Any]:
    topic = _find_topic(paths, cluster["name"])
    if topic is None:
        topic = {
            "topic_id": new_id("topic"),
            "name": cluster["name"],
            "background": cluster.get("summary", ""),
            "project": None,
            "user_goal": understanding.get("goal"),
            "progress": [],
            "introduced_solutions": [],
            "known": [],
            "interests": [],
            "dislikes": [],
            "practices": [],
            "corrections": [],
            "evidence": [],
            "discovery_ids": [],
            "status": "active",
            "created_at": at,
            "last_activity_at": at,
            "feedback": [],
        }
    topic["user_goal"] = understanding.get("goal") or topic.get("user_goal")
    topic.setdefault("progress", []).append(
        {"at": at, "note": understanding.get("activity") or "继续推进相关工作"}
    )
    topic["last_activity_at"] = at
    return topic


def _assemble_discovery(
    topic: dict[str, Any],
    cluster: dict[str, Any],
    understanding: dict[str, Any],
    score: dict[str, Any],
    exploration: dict[str, Any],
    rendered: dict[str, Any],
    config: dict[str, Any],
    now,
) -> dict[str, Any]:
    solutions = exploration.get("solutions") or []
    primary = solutions[0] if solutions else {}
    others = solutions[1:]
    discovery_id = new_id("discovery")
    created = to_iso(now)
    return {
        "discovery_id": discovery_id,
        "topic_id": topic["topic_id"],
        "topic_name": topic["name"],
        "created_at": created,
        "status": "observing",
        "feedback_due_at": to_iso(next_cutoff(now, config)),
        "expires_at": to_iso(now + timedelta(days=int(config["retention"]["feedback_days"]))),
        "title": rendered.get("title") or f"关于「{topic['name']}」的另一条路径",
        "observed": rendered.get("observed") or cluster.get("summary", ""),
        "problem_understanding": understanding,
        "score": score,
        "directions": exploration.get("directions", []),
        "primary_solution": primary,
        "other_solutions": others,
        "comparison": rendered.get("comparison", ""),
        "closing_question": rendered.get("closing_question", ""),
        "evidence": exploration.get("evidence") or rendered.get("evidence", []),
        "confidence_notes": rendered.get("confidence_notes", ""),
        "search_queries": exploration.get("search_queries", []),
        "feedback": {"signal": "none", "confidence": 0.0, "reason": ""},
        "feedback_event_ids": [],
        "source_event_ids": cluster.get("event_ids", []),
    }


def _render_report(paths: FomorPaths, config: dict[str, Any], now, feedback: dict, discoveries: list[dict], skipped: str | None) -> str:
    day = local_day(now, config["timezone"])
    lines = [f"# Fomor 探索报告 · {day}", ""]
    lines.append("## 反馈回看")
    if not feedback["evaluated"]:
        lines.append("今天没有待回看的探索结果。")
    else:
        lines.append(
            f"评估 {len(feedback['evaluated'])} 条；"
            f"移入长期记忆 {len(feedback['promoted'])} 条；"
            f"明确不感兴趣 {len(feedback['dismissed'])} 条；"
            f"过期 {len(feedback['expired'])} 条。"
        )
    lines.append("")
    lines.append("## 本次新发现")
    if skipped:
        lines.append(skipped)
    elif not discoveries:
        lines.append("本次没有发现值得探索的新方向，不做硬推。")
    for discovery in discoveries:
        lines.append("")
        lines.append(f"### {discovery['title']}")
        lines.append("")
        lines.append(discovery.get("observed", ""))
        lines.append("")
        understanding = discovery.get("problem_understanding", {})
        lines.append(f"**可能在解决**：{understanding.get('goal') or 'unknown'}")
        lines.append("")
        lines.append(f"**当前方式**：{understanding.get('current_approach') or 'unknown'}")
        lines.append("")
        lines.append(f"**主要阻碍**：{'；'.join(understanding.get('frictions') or []) or 'unknown'}")
        lines.append("")
        primary = discovery.get("primary_solution") or {}
        if primary:
            lines.append(f"**一条值得了解的新思路：{primary.get('name', '')}**")
            lines.append("")
            lines.append(primary.get("core_idea", ""))
            lines.append("")
            lines.append(f"流程：{primary.get('workflow', '')}")
            lines.append("")
            lines.append(f"限制：{'；'.join(primary.get('constraints') or [])}")
        others = discovery.get("other_solutions") or []
        if others:
            lines.append("")
            lines.append("**其他可选方案**")
            for solution in others:
                lines.append(
                    f"- {solution.get('name')}（{solution.get('relationship', 'unknown')}）："
                    f"{solution.get('core_idea', '')}"
                )
        if discovery.get("comparison"):
            lines.append("")
            lines.append(f"**与当前方式的区别**：{discovery['comparison']}")
        if discovery.get("closing_question"):
            lines.append("")
            lines.append(f"**留给你判断**：{discovery['closing_question']}")
    lines.append("")
    lines.append("---")
    lines.append("如果这条探索对你有用，直接继续追问即可；没有追问的内容会在到期后自动删除。")
    text = "\n".join(lines) + "\n"
    paths.reports_dir.mkdir(parents=True, exist_ok=True)
    (paths.reports_dir / f"{day}.md").write_text(text, encoding="utf-8")
    (paths.reports_dir / "latest.md").write_text(text, encoding="utf-8")
    return text


def run_analysis(
    paths: FomorPaths,
    config: dict[str, Any] | None = None,
    llm: BaseLLM | None = None,
    now=None,
    scheduled: bool = False,
    make_backup: bool = True,
) -> dict[str, Any]:
    config = config or load_config(paths)
    moment = now or utcnow()
    paths.ensure()
    with file_lock(paths.lock_file):
        if scheduled and not is_due(paths, config, moment):
            return {
                "status": "skipped",
                "reason": "not_due",
                "report": f"还没到下一次 {schedule_label(config)}，且已有成功运行记录。",
            }
        state = load_state(paths)
        run_id = new_id("run")
        started = to_iso(moment)
        window_start = _window_start(paths, state, moment)
        recent_events = sorted(iter_events(paths, since=window_start, until=moment), key=lambda e: e["timestamp"])
        feedback_events = sorted(
            iter_events(
                paths,
                since=min(
                    [parse_iso(item["created_at"]) for item in list_discoveries(paths, status="observing")]
                    or [window_start]
                ),
                until=moment,
            ),
            key=lambda e: e["timestamp"],
        )
        feedback = evaluate_feedback(paths, config, feedback_events, run_id, moment)

        new_events = [
            event
            for event in recent_events
            if not event.get("analyzed_at")
        ][: int(config["analysis"]["max_events_per_run"])]
        skipped = None
        discoveries: list[dict[str, Any]] = []
        provider = llm or build_llm(config)

        if len(new_events) < int(config["analysis"]["min_events_for_discovery"]):
            skipped = "本次没有新的用户问题，暂不生成探索。"
        else:
            try:
                aggregated = provider.json("aggregate", {"date": local_day(moment, config["timezone"]), "events": new_events})
                clusters = aggregated.get("topics", [])[: int(config["analysis"]["max_topics_per_run"])]
                by_id = {event["event_id"]: event for event in new_events}
                for cluster in clusters:
                    events = [by_id[event_id] for event_id in cluster.get("event_ids", []) if event_id in by_id]
                    if not events:
                        events = new_events
                    understanding = provider.json(
                        "understand",
                        {"topic_name": cluster["name"], "events": events},
                    )
                    score = provider.json(
                        "opportunity",
                        {"topic_name": cluster["name"], "understanding": understanding},
                    )
                    decision = score.get("decision", "none")
                    total = float(score.get("total", 0))
                    if decision == "explore" and total < float(config["scoring"]["explore_threshold"]):
                        decision = "watch"
                    at = to_iso(moment)
                    if decision != "explore":
                        continue
                    exploration = provider.json(
                        "explore",
                        {"topic_name": cluster["name"], "understanding": understanding, "score": score},
                    )
                    rendered = provider.json(
                        "discovery",
                        {
                            "topic_name": cluster["name"],
                            "events": events,
                            "understanding": understanding,
                            "score": score,
                            "exploration": exploration,
                        },
                    )
                    # Create the topic first, then attach the finalized discovery.
                    topic = _upsert_topic(paths, cluster, understanding, at)
                    discovery = _assemble_discovery(
                        topic, cluster, understanding, score, exploration, rendered, config, moment
                    )
                    topic.setdefault("discovery_ids", []).append(discovery["discovery_id"])
                    for solution in [discovery.get("primary_solution"), *discovery.get("other_solutions", [])]:
                        if solution and solution.get("name") not in topic.setdefault("introduced_solutions", []):
                            topic["introduced_solutions"].append(solution["name"])
                    save_topic(paths, topic)
                    save_discovery(paths, discovery)
                    mark_events_analyzed(paths, events, topic["topic_id"], moment)
                    discoveries.append(discovery)
            except Exception as error:  # keep a readable failure record for the skeleton
                skipped = f"分析失败：{error}"

        report = _render_report(paths, config, moment, feedback, discoveries, skipped)
        finished = to_iso(utcnow())
        failed = bool(skipped and skipped.startswith("分析失败"))
        status = "failed" if failed else "completed"
        append_run(
            paths,
            {
                "run_id": run_id,
                "run_type": "scheduled" if scheduled else "manual",
                "status": status,
                "started_at": started,
                "finished_at": finished,
                "window_start": to_iso(window_start),
                "window_end": to_iso(moment),
                "feedback": feedback,
                "discovery_ids": [item["discovery_id"] for item in discoveries],
                "event_count": len(new_events),
                "error": skipped if status == "failed" else None,
            },
        )
        state.update(
            {
                "last_attempt_at": started,
                "last_run_id": run_id,
                "last_event_count": len(new_events),
            }
        )
        if status == "completed":
            state["last_success_at"] = started
            save_state(paths, state)
        else:
            save_state(paths, state)
        if make_backup:
            backup_data(paths)
        cleanup_events(paths, config)
        return {
            "status": status,
            "run_id": run_id,
            "feedback": feedback,
            "discoveries": [item["discovery_id"] for item in discoveries],
            "report": report,
            "skipped": skipped,
        }


# ============================================================================
# cli
# ============================================================================

def _paths(args: argparse.Namespace) -> FomorPaths:
    return FomorPaths.resolve(getattr(args, "home", None))


def _read_hook_payload() -> dict[str, Any] | None:
    raw = sys.stdin.read()
    if not raw.strip():
        return None
    payload = json.loads(raw)
    if not isinstance(payload, dict):
        raise ValueError("hook payload must be a JSON object")
    return payload


def cmd_init(args: argparse.Namespace) -> int:
    paths = _paths(args)
    config = ensure_initialized(paths)
    print(f"initialized: {paths.root}")
    print(f"schedule: every day at {config['schedule']['hour']:02d}:{config['schedule']['minute']:02d} ({config['timezone']})")
    print(f"retention: events={config['retention']['event_days']}d feedback={config['retention']['feedback_days']}d")
    return 0


def cmd_session_start(args: argparse.Namespace) -> int:
    """SessionStart hook: silently verify the environment, then catch up."""
    try:
        paths = _paths(args)
        config = ensure_initialized(paths)
        report = verify_environment(paths, config)
        result = catch_up(paths, config=config, detach=True)
        if args.verbose:
            print(json.dumps({**report, "catch_up": result}, ensure_ascii=False))
        return 0
    except Exception as error:  # never block the session
        print(f"fomor session-start error: {error}", file=sys.stderr)
        return 0


def cmd_hook(args: argparse.Namespace) -> int:
    """Fast, non-blocking UserPromptSubmit hook. Never breaks the user's turn."""
    try:
        payload = _read_hook_payload()
        if not payload:
            return 0
        paths = _paths(args)
        config = ensure_initialized(paths)
        payload.setdefault("platform", "trae")
        event = normalize_hook_payload(payload)
        if not event["user_message"]:
            return 0
        _, duplicate = append_event(paths, config, event)
        if duplicate:
            print("duplicate event skipped", file=sys.stderr)
        return 0
    except Exception as error:  # hooks must not block the agent
        print(f"fomor hook error: {error}", file=sys.stderr)
        return 0


def cmd_status(args: argparse.Namespace) -> int:
    paths = _paths(args)
    config = ensure_initialized(paths)
    state = load_state(paths)
    events = list(iter_events(paths))
    pending = list_discoveries(paths, status="observing")
    promoted = list_discoveries(paths, status="promoted")
    schedule = catch_up_inline(paths, config)
    print(f"home: {paths.root}")
    print(f"events: {len(events)}")
    print(f"topics: {len(list_topics(paths))}")
    print(f"discoveries: pending={len(pending)} promoted={len(promoted)}")
    print(f"last_success_at: {state.get('last_success_at', 'never')}")
    print(f"schedule: every day at {schedule_label(config)} ({config['timezone']})")
    print(f"analysis_due: {'yes' if schedule['due'] else 'no'}")
    print(f"latest_cutoff: {schedule['latest_cutoff']}")
    print(f"report: {paths.reports_dir / 'latest.md'}")
    return 0


def cmd_analyze(args: argparse.Namespace) -> int:
    paths = _paths(args)
    config = ensure_initialized(paths)
    if args.llm:
        config["llm"]["mode"] = args.llm
        save_config(paths, config)
    result = run_analysis(
        paths,
        config=config,
        scheduled=args.scheduled,
        make_backup=not args.no_backup,
    )
    if result["status"] == "skipped":
        print(result.get("report") or "skipped")
        return 0
    print(result["report"])
    return 0 if result["status"] == "completed" else 1


def cmd_catch_up(args: argparse.Namespace) -> int:
    paths = _paths(args)
    config = ensure_initialized(paths)
    if args.foreground:
        state = catch_up_inline(paths, config)
        if not state["due"]:
            print("not due")
            return 0
        result = run_analysis(paths, config=config, scheduled=True)
        print(result.get("report") or result["status"])
        return 0 if result["status"] == "completed" else 1
    result = catch_up(paths, config=config, detach=True)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def cmd_prompts(args: argparse.Namespace) -> int:
    for name in ["system", *describe_tasks()]:
        print(name)
    return 0


def build_parser() -> argparse.ArgumentParser:
    # ``--home`` is accepted both before and after the subcommand so the
    # detached catch-up command can be written unambiguously.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--home", default=argparse.SUPPRESS, help="data directory, default ~/.fomor")

    parser = argparse.ArgumentParser(prog="fomor", description="Fomor local exploration assistant")
    parser.add_argument("--home", default=None, help="data directory, default ~/.fomor")
    parser.add_argument("--version", action="version", version=f"fomor {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init", parents=[common], help="create ~/.fomor and default settings")
    init.set_defaults(func=cmd_init)

    session = sub.add_parser(
        "session-start",
        parents=[common],
        help="verify/repair the local environment, then catch up if the configured daily run was missed",
    )
    session.add_argument("--verbose", action="store_true", help="print the environment report")
    session.set_defaults(func=cmd_session_start)

    hook = sub.add_parser("hook", parents=[common], help="read a Trae UserPromptSubmit payload from stdin")
    hook.set_defaults(func=cmd_hook)

    status = sub.add_parser("status", parents=[common], help="show counts and schedule state")
    status.set_defaults(func=cmd_status)

    analyze = sub.add_parser("analyze", parents=[common], help="run feedback review and analysis")
    analyze.add_argument("--scheduled", action="store_true", help="only run when the configured daily cutoff is due")
    analyze.add_argument("--llm", choices=["mock", "traecli", "openai"], help="override llm mode")
    analyze.add_argument("--no-backup", action="store_true")
    analyze.set_defaults(func=cmd_analyze)

    catch = sub.add_parser("catch-up", parents=[common], help="spawn analysis if the configured daily run was missed")
    catch.add_argument("--foreground", action="store_true", help="run inline instead of spawning")
    catch.set_defaults(func=cmd_catch_up)

    prompts = sub.add_parser("prompts", parents=[common], help="list prompt tasks")
    prompts.set_defaults(func=cmd_prompts)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())



if __name__ == "__main__":
    raise SystemExit(main())
