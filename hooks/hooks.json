{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${TRAE_PLUGIN_ROOT}/scripts/fomor\" hook",
            "commandWindows": "python \"${TRAE_PLUGIN_ROOT}/scripts/fomor\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${TRAE_PLUGIN_ROOT}/scripts/fomor\" catch-up",
            "commandWindows": "python \"${TRAE_PLUGIN_ROOT}/scripts/fomor\" catch-up",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
